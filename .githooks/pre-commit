#!/usr/bin/env bash
# Staged file content. Advisory layer — CI is the non-bypassable one.
command -v gitleaks >/dev/null 2>&1 || { echo "⚠️  gitleaks not installed — skipping" >&2; exit 0; }
gitleaks protect --staged --redact -v || {            # v8.19+: gitleaks git --staged --redact -v
  echo "❌ gitleaks: secret in staged changes — commit blocked" >&2; exit 1; }
